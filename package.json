{
  "name": "anysvg",
  "productName": "AnySVG",
  "version": "1.0.0",
  "description": "AnySVG — Studio-Grade Vector Rasterizer Desktop App",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite",
    "dev:renderer": "electron-vite --rendererOnly",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:dmg": "electron-vite build && electron-builder --mac dmg --arm64 --x64",
    "build:win": "electron-vite build && electron-builder --win nsis",
    "build:all": "electron-vite build && electron-builder -mw",
    "preview": "electron-vite preview",
    "start": "electron-vite preview"
  },
  "keywords": [
    "svg",
    "png",
    "converter",
    "high-resolution",
    "retina",
    "4k",
    "8k",
    "vector",
    "rasterizer"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@img/colour": "^1.1.0",
    "clsx": "^2.1.1",
    "detect-libc": "^2.1.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.5",
    "@img/sharp-darwin-x64": "0.35.5",
    "@img/sharp-libvips-darwin-arm64": "1.3.4",
    "@img/sharp-libvips-darwin-x64": "1.3.4",
    "@img/sharp-win32-arm64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5",
    "@img/sharp-libvips-win32-arm64": "1.3.4",
    "@img/sharp-libvips-win32-x64": "1.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
